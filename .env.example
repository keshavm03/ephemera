# ---- Upstash Redis (required) -------------------------------------------
# Vercel dashboard -> Storage -> Upstash for Redis -> Connect Project.
# Vercel injects these automatically once connected. For local dev, copy the
# REST credentials from the Upstash console into .env.local.
KV_REST_API_URL=https://xxxx.upstash.io
KV_REST_API_TOKEN=AXXXXXXXXXXXXXXXXXXX

# Fallback names also accepted (Upstash console uses these):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- Session signing secret (required) ----------------------------------
# Any long random string. Generate one with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Giphy (optional) ---------------------------------------------------
# Free key from https://developers.giphy.com/dashboard/
#   Create Account -> Create an App -> pick "API", NOT "SDK".
# The SDK option hands you a key that the REST endpoints this app calls will
# reject, and the resulting error looks like a bad key rather than a wrong one.
#
# The value is 32 alphanumeric characters, e.g.
#   GIPHY_API_KEY=AbC123dEf456GhI789jKl012MnO345pQ
#
# Server-side only. Never rename this to NEXT_PUBLIC_GIPHY_API_KEY — that would
# inline the key into the client bundle for anyone to read. /api/giphy exists
# precisely so the key stays on the server.
#
# On Vercel, add it as a NORMAL variable, not a "Sensitive" one, for the same
# reason described above for Redis: a Sensitive variable registers its key but
# injects an empty value at runtime, so the GIF tab would silently stay hidden.
#
# Without a key the GIF tab hides itself and stickers still work.
GIPHY_API_KEY=
